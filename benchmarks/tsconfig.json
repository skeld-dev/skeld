{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsout",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["**/*.ts"],
  "references": [
    {
      "path": "../packages/core"
    },
    {
      "path": "../packages/auth"
    },
    {
      "path": "../packages/openapi"
    },
    {
      "path": "../tests/schema"
    }
  ],
  "exclude": ["type-cost"]
}
