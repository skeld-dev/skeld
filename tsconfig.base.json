{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "lib": ["es2025"],
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "customConditions": ["skeld-source"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
