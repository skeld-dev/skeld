{
  "name": "@skeld/openapi",
  "version": "0.4.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skeld-dev/skeld.git",
    "directory": "packages/openapi"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26.12.0"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "skeld-source": "./src/openapi/openapi.ts",
      "types": "./dist/openapi/openapi.d.ts",
      "default": "./dist/openapi/openapi.js"
    },
    "./openapi-error": {
      "skeld-source": "./src/openapi/openapi-error.ts",
      "types": "./dist/openapi/openapi-error.d.ts",
      "default": "./dist/openapi/openapi-error.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@skeld/core": "^0.4.5"
  },
  "devDependencies": {
    "@skeld/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "OpenAPI 3.1.2 documents generated offline from a Skeld contract, with located diagnostics for what OpenAPI cannot express.",
  "homepage": "https://skeld.dev"
}
