{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*.ts"],
      "project": ["tools/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples/*": {},
    "benchmarks": {
      "entry": ["servers/*.ts"]
    },
    "tests": {
      "entry": ["acceptance/*.ts", "type-cost/*.ts"]
    }
  }
}
