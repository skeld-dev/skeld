{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreBinaries": ["openssl", "taskset"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    "website": {
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples/auth": {
      "entry": ["server.ts", "walkthrough.ts", "postgres-store.ts"]
    },
    "examples/openapi": {
      "entry": ["service.ts"]
    },
    "examples/*": {},
    "benchmarks": {
      "entry": [
        "servers/*.ts",
        "diag/scenario-server.ts",
        "browser-costs.ts",
        "browser-server.ts",
        "logging/*.ts",
        "schema/*.ts",
        "type-cost/*.ts"
      ]
    },
    "tests": {
      "entry": [
        "security/*.ts",
        "browser/*.ts",
        "lifecycle/*.ts",
        "contracts/*.ts",
        "logging/*.ts",
        "schema/*.ts",
        "auth/*.ts",
        "openapi/*.ts"
      ],
      "ignoreBinaries": ["prlimit"]
    },
    "tools": {
      "entry": ["*.ts"],
      "ignoreDependencies": ["@skeld/auth", "@skeld/openapi"]
    }
  }
}
