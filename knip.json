{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreBinaries": ["taskset"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples/*": {},
    "benchmarks": {
      "entry": [
        "servers/*.ts",
        "diag/scenario-server.ts",
        "browser-costs.ts",
        "browser-server.ts",
        "logging/*.ts",
        "schema/*.ts",
        "type-cost/*.ts"
      ]
    },
    "tests": {
      "entry": ["security/*.ts", "browser/*.ts", "lifecycle/*.ts", "contracts/*.ts", "logging/*.ts", "schema/*.ts"]
    },
    "tools": {
      "entry": ["*.ts"]
    }
  }
}
