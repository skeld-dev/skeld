{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreBinaries": ["taskset"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples/*": {},
    "benchmarks": {
      "entry": ["servers/*.ts", "diag/scenario-server.ts", "browser-costs.ts", "browser-server.ts"]
    },
    "tests": {
      "entry": ["acceptance/*.ts", "type-cost/*.ts", "schema/*.ts"]
    },
    "tools": {
      "entry": ["*.ts"]
    }
  }
}
