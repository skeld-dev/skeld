{
  "name": "darkstart",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks",
    "tests",
    "tools"
  ],
  "scripts": {
    "check": "tsc -b",
    "lint": "biome check .",
