    "readme-check": "node tools/check-readme-example.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "knip": "6.43.0",
    "typescript": "7.0.2"
  }
}
