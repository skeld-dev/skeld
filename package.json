{
  "name": "skeld",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "check": "tsc -b",
    "test": "tsc -b && node --conditions=skeld-source tests/run.ts",
    "lint": "biome check .",
    "knip": "knip",
    "bench": "tsc -b packages/core && node benchmarks/run.ts",
    "reference-check": "node tools/check-reference-example.ts",
    "examples-check": "tsc -b && node tools/check-examples.ts",
    "pack-check": "node tools/check-pack-markers.ts --pack",
    "api-check": "node tools/api-reference/check.ts",
    "api-docs": "node tools/api-reference/generate.ts",
    "consumer-check": "node tools/check-consumer-lib.ts",
    "differential": "node --conditions=skeld-source tests/schema/differential.ts",
    "sast": "node tools/sast.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "knip": "6.48.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.19.0"
}
