{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsout",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "*.ts",
    "security/**/*.ts",
    "browser/**/*.ts",
    "lifecycle/**/*.ts",
    "contracts/**/*.ts",
    "logging/**/*.ts",
    "auth/**/*.ts",
    "openapi/**/*.ts",
    "data/**/*.ts",
    "support/**/*.ts"
  ],
  "references": [
    {
      "path": "../packages/core"
    },
    {
      "path": "../packages/auth"
    },
    {
      "path": "../packages/openapi"
    },
    {
      "path": "../packages/data"
    }
  ]
}
